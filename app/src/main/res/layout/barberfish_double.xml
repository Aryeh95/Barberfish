<?xml version="1.0" encoding="utf-8"?>
<!--
    Double field, side by side. Each slot is filled via RemoteViews.removeAllViews() + addView()
    with a barberfish_field.xml RemoteViews instance, as in the HUD; a slot whose sensor is not
    paired is hidden and the weights hand its width to the other.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/double_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/double_slot_first"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <FrameLayout
        android:id="@+id/double_slot_second"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

</LinearLayout>
