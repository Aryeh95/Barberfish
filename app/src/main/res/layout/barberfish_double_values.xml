<?xml version="1.0" encoding="utf-8"?>
<!--
    Double field without labels: each value is one bitmap (renderDoublePanelBitmap) drawn at its
    panel's pixel size, side by side. A slot whose sensor is not paired is hidden and the weights
    hand its width to the other.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/double_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/double_panel_first"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/double_panel_second"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="fitCenter" />

</LinearLayout>
